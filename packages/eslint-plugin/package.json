{
	"name": "@baileys-li/eslint-plugin",
	"version": "0.1.0",
	"description": "Opinionated ESLint rules for TypeScript and Node.js code style",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"test": "tsx --test 'src/**/*.test.ts'"
	},
	"devDependencies": {
		"@types/estree": "^1.0.0",
		"eslint": "^9.0.0",
		"tsup": "^8.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"eslint": ">=9.0.0"
	}
}
