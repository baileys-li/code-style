{
	"name": "@baileys-li/eslint-plugin",
	"version": "0.1.0",
	"description": "Opinionated ESLint rules for TypeScript and Node.js code style",
	"keywords": [
		"arrow-functions",
		"code-style",
		"eslint",
		"eslint-plugin",
		"eslintplugin",
		"function-declaration",
		"typescript"
	],
	"homepage": "https://github.com/baileys-li/code-style/tree/main/packages/eslint-plugin#readme",
	"bugs": "https://github.com/baileys-li/code-style/issues",
	"license": "MIT",
	"author": "Arthur Baileys Li <arthurlitovko@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/baileys-li/code-style.git",
		"directory": "packages/eslint-plugin"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"test": "tsx --test 'src/**/*.test.ts'"
	},
	"devDependencies": {
		"@types/estree": "^1.0.0",
		"@types/node": "^25.9.1",
		"eslint": "^9.0.0",
		"tsdown": "^0.22.1",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"eslint": ">=9.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
